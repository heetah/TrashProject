# Production pipeline local configuration.
# Copy to .env. Values explicitly exported by the shell or UI worker take precedence.
# Relative model paths are resolved from the repository root.

# --- Model paths ---
POSE_MODEL_PATH=modules_weight/yolo26x-pose.pt
STGCN_WEIGHT_PATH=modules_weight/best_stgcn_0623.pth
STGCN_CONFIG_PATH=mmaction2/configs/skeleton/stgcnpp/custom_trash_stgcnpp.py
MODEL_BBOX_PATH=modules_weight/best-yolo-seg_v3.pt
MODEL_TRASH_PATH=modules_weight/best-rtdetr-4c-background.pt
MODEL_BBOX_PATH_BATCH=modules_weight/batch/best-yolo-seg_v3.pt
MODEL_TRASH_PATH_BATCH=modules_weight/best-rtdetr-4c-background.pt
PLATE_MODEL_PATH=modules_weight/best-licnese-plate.pt
PLATE_OCR_MODEL_NAME=en_PP-OCRv5_mobile_rec

# --- Device / model runtime ---
# Blank device means auto-select CUDA when available, otherwise CPU.
YOLO_DEVICE=
BBOX_DEVICE=
TRASH_DEVICE=
ACTION_DEVICE=
PLATE_DETECT_DEVICE=
PLATE_OCR_DEVICE=cpu
PREFER_TENSORRT=1
RTDETR_ENABLED=1

# --- Common detector thresholds ---
BBOX_CONF=0.45
TRASH_CONF=0.4
ACTOR_TRACK_IOU=0.3
MOVING_THRESHOLD=0.25
CORE_MOVING_THRESHOLD=0.3
LITTER_DISTANCE_THRESHOLD=250
VEHICLE_GATE=1
VEHICLE_GATE_TTL_SEC=3.0

# --- Pipeline / batching ---
PIPELINE_BATCH=8
PIPELINE_QUEUE_SIZE=8
PIPELINE_PREPARE_4C=1
YOLO_SEG_FRAME_SKIP=2
ACTOR_MODE=predict
RTDETR_ZERO_REPAIR=off
PROFILE_ENABLED=1

# --- STGCN / YOLO-Pose action branch ---
ACTION_THRESHOLD=0.5
ACTION_WINDOW=100
ACTION_POSE_CONF=0.3
ACTION_POSE_IMGSZ=0
ACTION_PREDICT_INTERVAL=1
ACTION_BBOX_NORM=1
ACTION_BBOX_NORM_PAD=0.15
ACTION_BBOX_NORM_CONF=0.3
ACTION_KP_SMOOTH=1
ACTION_KP_SMOOTH_WIN=3
ACTION_KP_INTERP_CONF=0.3
# Blank keeps the dynamic default equal to ACTION_WINDOW.
ACTION_SAMPLE_SPAN=
URINATION_WINDOW_SEC=8.0
URINATION_MIN_SEC=5.0
# Blank high threshold follows ACTION_THRESHOLD.
ACTION_URINATE_CONF_HIGH=
ACTION_URINATE_CONF_LOW=0.3
ACTION_URINATE_TOPP=1
# Blank mass follows 0.7 * URINATION_MIN_SEC.
ACTION_URINATE_TOPP_MASS=
ACTION_URINATE_TOPP_FLOOR=0.2
ACTION_EVIDENCE_DEBUG=0

# --- License plate detector / OCR ---
PLATE_DETECT_CONF=0.6
PLATE_ACCEPT_DETECT_CONF=0.8
PLATE_OCR_CONFIDENCE=0.85
PLATE_SCAN_SKIP=10

# --- Motion mask / litter component evidence ---
MOTION_MASK_MODE=temporal
FG_MASK_SCALE=0.5
MOTION_DIFF_THRESHOLD=10
MOTION_DILATE_ITERATIONS=2
MOTION_BLUR_KERNEL=0
MOTION_OPEN_KERNEL=3
MOTION_OPEN_ITERATIONS=0
MOTION_CLOSE_KERNEL=0
MOTION_CLOSE_ITERATIONS=0
MOTION_MIN_COMPONENT_AREA=4
MOTION_MIN_LARGEST_COMPONENT_RATIO=0.25
MOTION_MOG2_DETECT_SHADOWS=1

# --- Video input / output ---
OUTPUT_ROOT=.
VIDEO_HW_ACCEL=any
VIDEO_HW_DEVICE=
VIDEO_CAPTURE_BUFFER_SIZE=8
VIDEO_READ_THREADS=0
FFMPEG_BIN=
WRITER_QUEUE_SIZE=16
WRITER_PRESET=fast
WRITER_CRF=23
WRITER_ENCODER=auto
VIOLATOR_DISPLAY_TTL=60
VIOLATOR_DISPLAY_MAX_JUMP=80.0

# --- Smart Backtrack production / research controls ---
SMART_BACKTRACK=1
SMART_BACKTRACK_SIDECAR=0
SMART_BACKTRACK_STUDY_STAGE=full
SMART_BACKTRACK_CONTEXT_SEC=10.0
SMART_BACKTRACK_RAW_PREFIX=1
# Blank keeps the FPS-scaled 2.4-second computational search guard.
SMART_BACKTRACK_MAX_BACK_FRAMES=
SMART_BACKTRACK_TOPK_PERSON=5
SMART_BACKTRACK_TOPK_VEHICLE=5
SMART_BACKTRACK_DUSTBIN_COST=7.0
SMART_BACKTRACK_NULL_VEHICLE_COST=1.4
SMART_BACKTRACK_DIRECT_VEHICLE_COST=0.9
SMART_BACKTRACK_AC_WEIGHT=0.75
SMART_BACKTRACK_BC_SUPPORT_BONUS=0.25
# Experimental full/reverse C_BC penalty. Keep 0 until reviewed replay approval.
SMART_BACKTRACK_BC_BOUNDARY_DEPTH_WEIGHT=0.0
SMART_BACKTRACK_SIGMA_FLOOR=2.0
# Deprecated replay-compatible input; no longer a physical two-point cutoff.
SMART_BACKTRACK_TWO_POINT_MAX_BACK_SEC=0.4
SMART_BACKTRACK_TWO_POINT_PRIOR_COST=1.0
SMART_BACKTRACK_MAX_FORWARD_RELEASE_SEC=0.5
SMART_BACKTRACK_RELEASE_WINDOW_WEIGHT=0.35
SMART_BACKTRACK_DT_DISTANCE_WEIGHT=1.0
SMART_BACKTRACK_DT_TIME_WEIGHT=1.0
# Actor observation freshness: soft keeps candidates and adds
# rho(z)=z+kappa*max(0,z-1)^2, z=max(dt/0.25s, df/3frames).
SMART_BACKTRACK_TIME_COST_MODE=soft
SMART_BACKTRACK_TIME_SOFT_KAPPA=4.0

# --- Online pseudo-homography self-calibration (Phase 1-8) ---
# Calibration and its use by Smart Backtrack are separate opt-ins. Attribution
# requires a LOCKED event snapshot at or above the confidence threshold;
# otherwise that event explicitly keeps image-space geometry.
DYNAMIC_HOMOGRAPHY=0
SMART_BACKTRACK_DYNAMIC_HOMOGRAPHY=0
SMART_BACKTRACK_HOMOGRAPHY_MIN_CONFIDENCE=0.65
DYNAMIC_HOMOGRAPHY_WINDOW_SEC=100
DYNAMIC_HOMOGRAPHY_BOTTOM_PERCENTILE=98
DYNAMIC_HOMOGRAPHY_MIN_MASK_AREA=64
DYNAMIC_HOMOGRAPHY_BORDER_MARGIN_FRAC=0.01
DYNAMIC_HOMOGRAPHY_MIN_CONF=0.45
DYNAMIC_HOMOGRAPHY_QUALITY_THRESHOLD=0.60
DYNAMIC_HOMOGRAPHY_MIN_TRACK_POINTS=3
DYNAMIC_HOMOGRAPHY_MIN_TRACK_PATH_PX=6
DYNAMIC_HOMOGRAPHY_MIN_LOCAL_MOTION_PX=1
DYNAMIC_HOMOGRAPHY_MAX_SPEED_DIAG_SEC=2.0
DYNAMIC_HOMOGRAPHY_MAX_ACCEL_DIAG_SEC2=4.0
DYNAMIC_HOMOGRAPHY_MAX_LOCAL_TURN_DEG=135
DYNAMIC_HOMOGRAPHY_MAX_TRACK_GAP_SEC=2.0
DYNAMIC_HOMOGRAPHY_MIN_MASK_BBOX_FILL=0.10
DYNAMIC_HOMOGRAPHY_MAX_POINTS_PER_TRACK=600
DYNAMIC_HOMOGRAPHY_MAX_TRACKS=2048
# Phase 2 spatial motion field and flow clustering.
DYNAMIC_HOMOGRAPHY_GRID_ROWS=12
DYNAMIC_HOMOGRAPHY_GRID_COLS=20
DYNAMIC_HOMOGRAPHY_MIN_CELL_SAMPLES=3
DYNAMIC_HOMOGRAPHY_DIRECTION_TRIM_FRAC=0.15
DYNAMIC_HOMOGRAPHY_CELL_SAMPLE_TARGET=12
DYNAMIC_HOMOGRAPHY_FLOW_POSITION_RADIUS=0.10
DYNAMIC_HOMOGRAPHY_FLOW_ANGLE_DEG=30
DYNAMIC_HOMOGRAPHY_FLOW_CONTINUITY_RADIUS=0.25
DYNAMIC_HOMOGRAPHY_FLOW_CONTINUITY_ANGLE_DEG=55
DYNAMIC_HOMOGRAPHY_FLOW_MIN_SAMPLES=4
DYNAMIC_HOMOGRAPHY_FLOW_MIN_TRACKS=2
DYNAMIC_HOMOGRAPHY_FLOW_SAMPLE_TARGET=20
# Phase 3 matrix/projection safety validation.
DYNAMIC_HOMOGRAPHY_MIN_ABS_DET=1e-12
DYNAMIC_HOMOGRAPHY_MAX_CONDITION=1000000
DYNAMIC_HOMOGRAPHY_MIN_DENOMINATOR=1e-6
DYNAMIC_HOMOGRAPHY_MAX_DENOM_RATIO=100
DYNAMIC_HOMOGRAPHY_MAX_ABS_COORD=20
DYNAMIC_HOMOGRAPHY_MIN_PROJECTED_AREA=1e-6
DYNAMIC_HOMOGRAPHY_REQUIRE_ORIENTATION=1
# Phase 4 robust candidate-H diagnostic losses. Equal weights are neutral
# starting values, not validated production constants.
DYNAMIC_HOMOGRAPHY_MOTION_WEIGHT=1.0
DYNAMIC_HOMOGRAPHY_SPEED_WEIGHT=1.0
DYNAMIC_HOMOGRAPHY_CURVATURE_WEIGHT=1.0
DYNAMIC_HOMOGRAPHY_DIRECTION_WEIGHT=1.0
DYNAMIC_HOMOGRAPHY_LANE_WEIGHT=1.0
DYNAMIC_HOMOGRAPHY_MOTION_HUBER_DELTA=0.50
DYNAMIC_HOMOGRAPHY_SPEED_HUBER_DELTA=0.35
DYNAMIC_HOMOGRAPHY_CURVATURE_HUBER_DELTA=0.261799
DYNAMIC_HOMOGRAPHY_DIRECTION_HUBER_DELTA=0.261799
DYNAMIC_HOMOGRAPHY_DIRECTION_PROBE_FRAC=0.01
# Phase 5 leave-one-track-out moving-median local centerline diagnostic.
DYNAMIC_HOMOGRAPHY_LANE_HUBER_DELTA=0.03
DYNAMIC_HOMOGRAPHY_LANE_NEIGHBORHOOD_FRAC=0.10
DYNAMIC_HOMOGRAPHY_LANE_MIN_PEER_OBS=2
DYNAMIC_HOMOGRAPHY_LANE_MIN_PEER_TRACKS=1
# Phase 6 bounded optimizer. Disabled until reviewed multi-camera replay.
DYNAMIC_HOMOGRAPHY_OPTIMIZE=0
DYNAMIC_HOMOGRAPHY_OPT_ITERATIONS=3
DYNAMIC_HOMOGRAPHY_OPT_ANISOTROPY_STEP=0.08
DYNAMIC_HOMOGRAPHY_OPT_SHEAR_STEP=0.04
DYNAMIC_HOMOGRAPHY_OPT_PERSPECTIVE_STEP=0.08
DYNAMIC_HOMOGRAPHY_OPT_STEP_DECAY=0.5
DYNAMIC_HOMOGRAPHY_OPT_MAX_ABS_PARAMETER=0.35
DYNAMIC_HOMOGRAPHY_OPT_DATA_WEIGHT=1.0
DYNAMIC_HOMOGRAPHY_OPT_PERSPECTIVE_WEIGHT=0.25
DYNAMIC_HOMOGRAPHY_OPT_TEMPORAL_WEIGHT=0.25
DYNAMIC_HOMOGRAPHY_OPT_PERSPECTIVE_HUBER_DELTA=0.25
DYNAMIC_HOMOGRAPHY_OPT_TEMPORAL_HUBER_DELTA=0.05
DYNAMIC_HOMOGRAPHY_OPT_MIN_VALID_TRACKS=4
DYNAMIC_HOMOGRAPHY_OPT_MIN_FLOW_CLUSTERS=1
DYNAMIC_HOMOGRAPHY_OPT_MIN_SPATIAL_COVERAGE=0.01
DYNAMIC_HOMOGRAPHY_OPT_MIN_DURATION_SEC=10
DYNAMIC_HOMOGRAPHY_OPT_MIN_REL_IMPROVEMENT=0.01
DYNAMIC_HOMOGRAPHY_OPT_FREEZE_CONFIDENCE=0.55
DYNAMIC_HOMOGRAPHY_OPT_MAX_UPDATE_ALPHA=0.20
DYNAMIC_HOMOGRAPHY_OPT_TARGET_TRACKS=12
DYNAMIC_HOMOGRAPHY_OPT_TARGET_FLOWS=2
DYNAMIC_HOMOGRAPHY_OPT_TARGET_SPATIAL_COVERAGE=0.10
DYNAMIC_HOMOGRAPHY_OPT_TARGET_DURATION_SEC=60
DYNAMIC_HOMOGRAPHY_OPT_TARGET_QUALITY=0.80
DYNAMIC_HOMOGRAPHY_OPT_RESIDUAL_SCALE=0.10
DYNAMIC_HOMOGRAPHY_OPT_STABILITY_SCALE=0.05
# Phase 7 persistent calibration state; evaluation is windowed, not per-frame.
DYNAMIC_HOMOGRAPHY_EVAL_INTERVAL_SEC=30
DYNAMIC_HOMOGRAPHY_LOCK_MIN_UPDATES=2
DYNAMIC_HOMOGRAPHY_LOCK_STABLE_WINDOWS=2
DYNAMIC_HOMOGRAPHY_DRIFT_WINDOWS=3
DYNAMIC_HOMOGRAPHY_DRIFT_RESIDUAL_RATIO=2.0
DYNAMIC_HOMOGRAPHY_DRIFT_ABS_INCREASE=0.05
DYNAMIC_HOMOGRAPHY_DRIFT_CENTROID_FRAC=0.08
DYNAMIC_HOMOGRAPHY_DRIFT_SPREAD_FRAC=0.08
DYNAMIC_HOMOGRAPHY_DRIFT_DIRECTION_TENSOR=0.25
DYNAMIC_HOMOGRAPHY_DRIFT_BACKGROUND_MOTION=0.03
DYNAMIC_HOMOGRAPHY_RESIDUAL_BASELINE_ALPHA=0.10
DYNAMIC_HOMOGRAPHY_CONFIDENCE_ALPHA=0.25
DYNAMIC_HOMOGRAPHY_DRIFT_CONFIDENCE_DECAY=0.80
DYNAMIC_HOMOGRAPHY_ROLLBACK_HISTORY=8
DYNAMIC_HOMOGRAPHY_METRICS_HISTORY=100
# Phase 8 optional ORB static-background stabilization. Caller must provide an
# exclusion mask covering every known vehicle, person and litter region.
DYNAMIC_HOMOGRAPHY_STABILIZE=0
DYNAMIC_HOMOGRAPHY_STAB_MAX_FEATURES=800
DYNAMIC_HOMOGRAPHY_STAB_RATIO_TEST=0.75
DYNAMIC_HOMOGRAPHY_STAB_MIN_MATCHES=20
DYNAMIC_HOMOGRAPHY_STAB_TARGET_MATCHES=80
DYNAMIC_HOMOGRAPHY_STAB_RANSAC_PX=3.0
DYNAMIC_HOMOGRAPHY_STAB_MIN_INLIER_RATIO=0.50
DYNAMIC_HOMOGRAPHY_STAB_MAX_TRANSLATION_FRAC=0.08
DYNAMIC_HOMOGRAPHY_STAB_MAX_ROTATION_DEG=5.0
DYNAMIC_HOMOGRAPHY_STAB_MAX_SCALE_CHANGE=0.08
DYNAMIC_HOMOGRAPHY_STAB_EXCLUSION_DILATE_PX=7

# --- Litter confirmation and legacy/experimental attribution controls ---
LITTER_REQUIRE_VEHICLE=0
# 1: show actor IDs and magenta pre-postprocessing RT-DETR litter boxes in annotated video.
LITTER_DEBUG=0
# Validated replay default; set 0.85 to reproduce the previous baseline.
LITTER_FP_CONTAINMENT_THR=0.999
LITTER_CANDIDATE_SIDECAR=0
LITTER_CANDIDATE_DEDUP=0
LITTER_CANDIDATE_DEDUP_IOU=0.5
# 8/27 manually reviewed confirmation-recovery production profile.
LITTER_CONFIRM_REQUIRE_BIRTH_ACTOR=0
LITTER_MIN_CONFIRM_AGE_VEHICLE=2
LITTER_MIN_CONFIRM_DOWNWARD_VEHICLE=7
LITTER_MIN_CONFIRM_HORIZONTAL_DISPLACEMENT=1
LITTER_MAX_HORIZ_TO_DOWN_RATIO_VEHICLE=10
LITTER_MIN_VEHICLE_RELATIVE_SEPARATION=0
# Vehicle-contained RT-DETR boxes are tracker-only evidence until a sustained
# same-carrier relative descent releases them. Ordinary and quarantined tracks
# remain identity-isolated so tentative vehicle-part history cannot confirm.
LITTER_VEHICLE_QUARANTINE_MIN_OBSERVATIONS=3
LITTER_VEHICLE_QUARANTINE_MIN_RELATIVE_DISPLACEMENT=25
LITTER_VEHICLE_QUARANTINE_MIN_RELATIVE_DOWNWARD=15
LITTER_VEHICLE_QUARANTINE_MIN_SCALE_RATIO=1
LITTER_VEHICLE_QUARANTINE_MIN_DOWNWARD_STEPS=2
LITTER_VEHICLE_QUARANTINE_MAX_GAP_SEC=0.35
LITTER_FP_STREAK_RATIO=10
LITTER_ALLOW_SHAKE_CANDIDATES=1
LITTER_BACKTRACK_REVVEL=0
LITTER_BACKTRACK_REVVEL_PTS=5
LITTER_BACKTRACK_REVVEL_MIN_SPEED=4.0
LITTER_BACKTRACK_REVVEL_GAIN=0.25
LITTER_BACKTRACK_REVVEL_MAX_BONUS=0.75
LITTER_BACKTRACK_REVVEL_MAX_PENALTY=1.25
LITTER_BEV_STABLE=0
LITTER_BEV_MIN_OBS=12
LITTER_BEV_RECOMPUTE_EVERY=8
LITTER_BEV_BUFFER_CAP=600
LITTER_DISMOUNT_EDGE=0
LITTER_DISMOUNT_TTL_SEC=8.0
LITTER_DISMOUNT_MIN_BIND=2
LITTER_BACKTRACK_TRAJFIT=0
LITTER_TRAJFIT_MIN_AIR_PTS=3
LITTER_TRAJFIT_MAX_BACK_FRAMES=24
LITTER_TRAJFIT_GATE=1.0
LITTER_TRAJFIT_MIN_SPEED=2.0
LITTER_TRAJFIT_SIGMA_FLOOR=2.0
PV_ASSOC=0
PV_ASSOC_TAU=
