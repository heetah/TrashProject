# Production pipeline local configuration.
# Copy to .env. Values explicitly exported by the shell or UI worker take precedence.
# Relative model paths are resolved from the repository root.

# --- Model paths ---
POSE_MODEL_PATH=modules_weight/yolo26x-pose.pt
STGCN_WEIGHT_PATH=modules_weight/best_stgcn_0623.pth
STGCN_CONFIG_PATH=mmaction2/configs/skeleton/stgcnpp/custom_trash_stgcnpp.py
MODEL_BBOX_PATH=modules_weight/best-yolo-seg_v3.pt
MODEL_TRASH_PATH=modules_weight/best-rtdetr-4c-background.pt
MODEL_BBOX_PATH_BATCH=modules_weight/batch/best-yolo-seg_v3.pt
MODEL_TRASH_PATH_BATCH=modules_weight/best-rtdetr-4c-background.pt
PLATE_MODEL_PATH=modules_weight/best-licnese-plate.pt
PLATE_OCR_MODEL_NAME=en_PP-OCRv5_mobile_rec

# --- Device / model runtime ---
# Blank device means auto-select CUDA when available, otherwise CPU.
YOLO_DEVICE=
BBOX_DEVICE=
TRASH_DEVICE=
ACTION_DEVICE=
PLATE_DETECT_DEVICE=
PLATE_OCR_DEVICE=cpu
PREFER_TENSORRT=1
RTDETR_ENABLED=1

# --- Common detector thresholds ---
BBOX_CONF=0.45
TRASH_CONF=0.4
ACTOR_TRACK_IOU=0.3
MOVING_THRESHOLD=0.25
CORE_MOVING_THRESHOLD=0.3
LITTER_DISTANCE_THRESHOLD=250
VEHICLE_GATE=1
VEHICLE_GATE_TTL_SEC=3.0

# --- Pipeline / batching ---
PIPELINE_BATCH=8
PIPELINE_QUEUE_SIZE=8
PIPELINE_PREPARE_4C=1
YOLO_SEG_FRAME_SKIP=2
ACTOR_MODE=predict
RTDETR_ZERO_REPAIR=off
PROFILE_ENABLED=1

# --- STGCN / YOLO-Pose action branch ---
ACTION_THRESHOLD=0.5
ACTION_WINDOW=100
ACTION_POSE_CONF=0.3
ACTION_POSE_IMGSZ=0
ACTION_PREDICT_INTERVAL=1
ACTION_BBOX_NORM=1
ACTION_BBOX_NORM_PAD=0.15
ACTION_BBOX_NORM_CONF=0.3
ACTION_KP_SMOOTH=1
ACTION_KP_SMOOTH_WIN=3
ACTION_KP_INTERP_CONF=0.3
# Blank keeps the dynamic default equal to ACTION_WINDOW.
ACTION_SAMPLE_SPAN=
URINATION_WINDOW_SEC=8.0
URINATION_MIN_SEC=5.0
# Blank high threshold follows ACTION_THRESHOLD.
ACTION_URINATE_CONF_HIGH=
ACTION_URINATE_CONF_LOW=0.3
ACTION_URINATE_TOPP=1
# Blank mass follows 0.7 * URINATION_MIN_SEC.
ACTION_URINATE_TOPP_MASS=
ACTION_URINATE_TOPP_FLOOR=0.2
ACTION_EVIDENCE_DEBUG=0

# --- License plate detector / OCR ---
PLATE_DETECT_CONF=0.6
PLATE_ACCEPT_DETECT_CONF=0.8
PLATE_OCR_CONFIDENCE=0.85
PLATE_SCAN_SKIP=10

# --- Motion mask / litter component evidence ---
MOTION_MASK_MODE=temporal
FG_MASK_SCALE=0.5
MOTION_DIFF_THRESHOLD=10
MOTION_DILATE_ITERATIONS=2
MOTION_BLUR_KERNEL=0
MOTION_OPEN_KERNEL=3
MOTION_OPEN_ITERATIONS=0
MOTION_CLOSE_KERNEL=0
MOTION_CLOSE_ITERATIONS=0
MOTION_MIN_COMPONENT_AREA=4
MOTION_MIN_LARGEST_COMPONENT_RATIO=0.25
MOTION_MOG2_DETECT_SHADOWS=1

# --- Video input / output ---
OUTPUT_ROOT=.
VIDEO_HW_ACCEL=any
VIDEO_HW_DEVICE=
VIDEO_CAPTURE_BUFFER_SIZE=8
VIDEO_READ_THREADS=0
FFMPEG_BIN=
WRITER_QUEUE_SIZE=16
WRITER_PRESET=fast
WRITER_CRF=23
WRITER_ENCODER=auto
VIOLATOR_DISPLAY_TTL=60
VIOLATOR_DISPLAY_MAX_JUMP=80.0

# --- Smart Backtrack production / research controls ---
SMART_BACKTRACK=1
SMART_BACKTRACK_SIDECAR=0
SMART_BACKTRACK_STUDY_STAGE=full
SMART_BACKTRACK_CONTEXT_SEC=10.0
# Blank keeps the FPS-scaled 2.4-second default.
SMART_BACKTRACK_MAX_BACK_FRAMES=
SMART_BACKTRACK_TOPK_PERSON=5
SMART_BACKTRACK_TOPK_VEHICLE=5
SMART_BACKTRACK_DUSTBIN_COST=7.0
SMART_BACKTRACK_NULL_VEHICLE_COST=1.4
SMART_BACKTRACK_DIRECT_VEHICLE_COST=0.9
SMART_BACKTRACK_AC_WEIGHT=0.75
SMART_BACKTRACK_BC_SUPPORT_BONUS=0.25
SMART_BACKTRACK_SIGMA_FLOOR=2.0
SMART_BACKTRACK_TWO_POINT_MAX_BACK_SEC=0.4
SMART_BACKTRACK_TWO_POINT_PRIOR_COST=1.0
SMART_BACKTRACK_MAX_FORWARD_RELEASE_SEC=0.5
SMART_BACKTRACK_DT_DISTANCE_WEIGHT=1.0
SMART_BACKTRACK_DT_TIME_WEIGHT=1.0

# --- Legacy / experimental attribution switches (normally keep disabled) ---
LITTER_REQUIRE_VEHICLE=0
LITTER_DEBUG=0
LITTER_BACKTRACK_REVVEL=0
LITTER_BACKTRACK_REVVEL_PTS=5
LITTER_BACKTRACK_REVVEL_MIN_SPEED=4.0
LITTER_BACKTRACK_REVVEL_GAIN=0.25
LITTER_BACKTRACK_REVVEL_MAX_BONUS=0.75
LITTER_BACKTRACK_REVVEL_MAX_PENALTY=1.25
LITTER_BEV_STABLE=0
LITTER_BEV_MIN_OBS=12
LITTER_BEV_RECOMPUTE_EVERY=8
LITTER_BEV_BUFFER_CAP=600
LITTER_DISMOUNT_EDGE=0
LITTER_DISMOUNT_TTL_SEC=8.0
LITTER_DISMOUNT_MIN_BIND=2
LITTER_BACKTRACK_TRAJFIT=0
LITTER_TRAJFIT_MIN_AIR_PTS=3
LITTER_TRAJFIT_MAX_BACK_FRAMES=24
LITTER_TRAJFIT_GATE=1.0
LITTER_TRAJFIT_MIN_SPEED=2.0
LITTER_TRAJFIT_SIGMA_FLOOR=2.0
PV_ASSOC=0
PV_ASSOC_TAU=
