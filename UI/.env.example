# Flask / React local review console
UI_HOST=127.0.0.1
UI_PORT=5000
UI_DATABASE_PATH=UI/data/ui.sqlite3
UI_UPLOAD_ROOT=UI/data/uploads
UI_OUTPUT_ROOT=output/ui_runs
UI_DISCOVERY_ROOTS=output
# 逗號分隔；只有列在這裡的 server-side 資料夾可以從 UI 排程。
UI_ALLOWED_INPUT_ROOTS=/home/se_copilot/trashProject/resources
UI_FRONTEND_DIST=UI/frontend/dist
UI_LOG_ROOT=UI/data/logs
UI_MAX_UPLOAD_MB=2048
UI_POLL_SECONDS=3
UI_FOLDER_RECURSIVE=1
UI_IMPORT_EXISTING=1
UI_WORKER_ENABLED=1

# scripts/main.py execution
UI_PIPELINE_ENTRYPOINT=scripts/main.py
UI_CONDA_EXECUTABLE=conda
UI_CONDA_ENV=rtdetr
UI_PIPELINE_BATCH=8

# Vite development server
VITE_DEV_HOST=127.0.0.1
VITE_DEV_PORT=5173
VITE_API_PROXY_TARGET=http://127.0.0.1:5000
VITE_API_BASE_URL=
